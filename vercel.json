{
  "version": 2,
  "name": "gadgetstock",
  "regions": ["sin1"],
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/products/([^/]+)", "dest": "/api/products/[id]/index.js?id=$1" },
    { "src": "/api/transactions/([^/]+)", "dest": "/api/transactions/[id]/index.js?id=$1" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/css/(.*)", "dest": "/public/css/$1" },
    { "src": "/js/(.*)",  "dest": "/public/js/$1" },
    { "src": "/pages/(.*)", "dest": "/public/pages/$1" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
