# =====================================================================
# GadgetStock - Environment Variables Template
# Salin file ini menjadi '.env.local' untuk penggunaan lokal
# =====================================================================

PORT=3000

# Supabase Credentials (Dapatkan dari Dashboard Supabase -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional Configurations
TAX_RATE=0.11
LOW_STOCK_THRESHOLD=10
